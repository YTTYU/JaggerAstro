---
import { sitePath } from '../utils/site-path';
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';
import { advantage, platformVariants } from '../content/copy';
const sections = [['platform','Платформа'],['terrain','На воде'],['engineering','Устройство'],['gallery','Галерея'],['history','История']];
const photos = [['poster','P-41 в студии с включёнными фарами',1920],['studio-rear','Грузовая платформа, вид сзади',1440],['studio-running-gear','Гусеничная ходовая',1440],['headlamp','Передняя фара',1440],['studio-cockpit','Руль и приборная панель',1440]] as const;
---
<Site title="P-41 — гусеничный вездеход-амфибия" home>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <Photo name="poster" large={1920} alt="" eager />
      <video muted loop playsinline preload="none" data-desktop={sitePath('/media/hero.mp4')} data-mobile={sitePath('/media/hero-mobile.mp4')}></video>
    </div>
    <div class="wrap hero-inner">
      <div class="hero-title"><h1 id="hero-title">P-41</h1><p>Гусеничный<br />вездеход-амфибия</p></div>
      <div class="hero-actions"><a class="solid-link" href="#platform">Смотреть платформу <span class="arrow down" aria-hidden="true"></span></a><a class="text-link" href={sitePath('/specs/')}>Характеристики <span class="arrow" aria-hidden="true"></span></a></div>
    </div>
  </section>

  <div class="platform-transition" aria-hidden="true"></div>

  <section class="platform light" id="platform" aria-labelledby="platform-title">
    <div class="wrap">
      <div class="platform-head"><h2 id="platform-title">Одна платформа,<br />три исполнения</h2><p>{advantage.body[0]}</p></div>
      <div class="modifier" data-modifier>
        <div class="variant-stage" aria-live="polite">
          {platformVariants.variants.map((v,i) => <figure id={`variant-${v.key}`} data-panel={v.key} hidden={i!==0}><Photo name={v.key} large={1760} alt={v.desc} sizes="(max-width: 760px) 90vw, 72vw" /></figure>)}
          <img id="dimension-overlay" src={sitePath('/media/platform-dimensions.svg')} width="4417" height="2350" alt="Размерные линии платформы" loading="lazy" />
        </div>
        <div class="variant-nav" role="group" aria-label="Исполнения платформы">
          {platformVariants.variants.map((v,i) => <button type="button" aria-controls={`variant-${v.key}`} aria-pressed={i === 0} data-variant={v.key}><img src={sitePath(`/media/${v.key}-640.webp`)} alt="" loading="lazy" />{v.label}</button>)}
        </div>
        <noscript><style>.variant-nav,#dimension-overlay{display:none}.variant-stage figure[hidden]{display:grid!important}</style></noscript>
      </div>
      <div class="platform-foot"><a class="text-link" href={sitePath('/specs/#platform-data')}>Параметры платформы <span class="arrow" aria-hidden="true"></span></a><a class="text-link" href={sitePath('/equipment/')}>Дополнительное оснащение <span class="arrow" aria-hidden="true"></span></a></div>
    </div>
  </section>

  <section class="terrain" id="terrain" aria-labelledby="terrain-title">
    <Photo name="water-crossing" alt="П-41 пересекает водную преграду" />
    <div class="wrap terrain-content">
      <h2 id="terrain-title">Уверенность<br />на воде</h2>
      <p>Водоизмещающая кабина и герметичный кузов позволяют вездеходу преодолевать водные преграды. Движение по воде — за счёт перематывания гусеничных лент.</p>
      <a class="text-link" href={sitePath('/specs/#water')}>Как устроена амфибия <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </section>

  <section class="engineering light" id="engineering" aria-labelledby="engineering-title">
    <div class="wrap engineering-grid">
      <div class="engineering-copy">
        <h2 id="engineering-title">Что внутри<br />P-41</h2>
        <a href={sitePath('/specs/#power')}><span><strong>Cummins 2.8</strong><small>Дизельный двигатель</small></span><span class="arrow" aria-hidden="true"></span></a>
        <a href={sitePath('/equipment/#winch')}><span><strong>5,5 т</strong><small>Тяговое усилие лебёдки</small></span><span class="arrow" aria-hidden="true"></span></a>
        <a href={sitePath('/equipment/#camera')}><span><strong>360°</strong><small>Круговой обзор, опция</small></span><span class="arrow" aria-hidden="true"></span></a>
      </div>
      <figure class="engineering-film" data-motion-scene>
        <Photo name="cabin" alt="Кабина P-41 со стороны грузового отсека" sizes="(max-width: 760px) 90vw, 55vw" />
        <video muted playsinline preload="none" data-desktop={sitePath('/media/cabin.mp4')} data-mobile={sitePath('/media/cabin-mobile.mp4')} aria-hidden="true"></video>
      </figure>
      <a class="text-link" href={sitePath('/equipment/')}>Все рабочие системы <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </section>

  <section class="gallery" id="gallery" aria-labelledby="gallery-title">
    <div class="wrap">
      <div class="gallery-head"><h2 id="gallery-title">П-41 снаружи<br />и внутри</h2><div class="gallery-controls" hidden><output aria-live="polite">01 / 05</output><button class="circle" data-gallery-prev aria-label="Предыдущий кадр"><span class="arrow left" aria-hidden="true"></span></button><button class="circle" data-gallery-next aria-label="Следующий кадр"><span class="arrow" aria-hidden="true"></span></button></div></div>
      <ul class="gallery-track" tabindex="0" aria-label="Кадры вездехода">{photos.map(([name,alt,large]) => <li><a href={sitePath(`/media/${name}-${large}.webp`)}><Photo name={name} large={large} alt={alt} sizes="(max-width: 760px) 82vw, 63vw" /></a></li>)}</ul>
      <a class="text-link" href={sitePath('/gallery/')}>Вся галерея <span class="arrow" aria-hidden="true"></span></a>
      <dialog class="photo-dialog" aria-label="Просмотр фотографии"><button class="circle" type="button" autofocus aria-label="Закрыть">×</button></dialog>
    </div>
  </section>

  <section class="story-link light" id="history" aria-labelledby="story-title">
    <div class="wrap">
      <a href={sitePath('/history/')} class="story-action"><h2 id="story-title">Гусеничное<br /><span>превосходство</span></h2><span class="story-cta">Наша история <span class="arrow" aria-hidden="true"></span></span></a>
      <Photo name="garage-badge" alt="Маркировка Jagger на металле" sizes="92vw" />
    </div>
  </section>

  <nav class="chapter-nav" aria-label="Навигатор по странице" hidden>
    <a class="chapter-next" href="#platform" aria-label="Следующий раздел"><span class="arrow down" aria-hidden="true"></span></a>
    <details><summary><span class="chapter-count" aria-hidden="true"></span><span class="chapter-label">Платформа</span></summary><ul>{sections.map(([id,label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul></details>
  </nav>
  <script src="../scripts/site.ts"></script>
</Site>
