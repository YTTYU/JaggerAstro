---
import Site from '../layouts/Site.astro';
import Photo from '../components/Photo.astro';
const groups = [
 {id:'power',title:'Силовая установка',rows:[['Двигатель','Cummins ISF 2.8'],['Рабочий объём','2,8 л'],['Тип топлива','Дизель']]},
 {id:'systems',title:'Оснащение',rows:[['Тяговое усилие лебёдки','5,5 т'],['Круговой обзор','Камеры 360°, заказная опция'],['Сцепное устройство','Фаркоп']]},
 {id:'platform-data',title:'Проектные параметры платформы П-4',rows:[['Скорость движения по суше','До 90 км/ч'],['Длина × ширина × высота','5 400 × 2 340 × 2 650 мм'],['Ширина гусеничного полотна','400 мм'],['Ход подвески','Более 280 мм'],['Высота внедорожного грунтозацепа','56 мм']]},
 {id:'water',title:'Амфибийность платформы П-4',rows:[['Движение на воде','Перематыванием гусеничных лент'],['Водооткачивающие помпы','2 × 225 л/мин'],['Ширина проёмов люка и двери в кузов','800 мм']]},
 {id:'tracks',title:'Ходовая часть П-4',rows:[['Тип подвески','Длинноходная рычажно-балансирная'],['Гусеничные ленты','Резинокордовые, внедорожные или индустриальные'],['Натяжение лент','Регулируется гидравлическими ленивцами']]},
 {id:'transmission',title:'Трансмиссия платформы П-4',rows:[['Коробка передач','Автоматическая или механическая'],['Раздаточная коробка','ГАЗ-3308 «Садко»'],['Главная передача','Модифицированная ГАЗ-71'],['Бортовая передача','Редуктор ГАЗ-34039']]},
];
---
<Site title="Характеристики P-41">
  <section class="sub-hero"><Photo name="gallery-track" large={1800} alt="Гусеничная ходовая вездехода" eager /><div class="wrap"><h1>Характеристики</h1><p>Силовая установка и оснащение P-41. Проектные параметры платформы П-4 приведены отдельно.</p></div></section>
  <div class="wrap spec-layout light-content">
    <aside><nav aria-label="Характеристики">{groups.map(g=><a href={`#${g.id}`}>{g.title}</a>)}</nav></aside>
    <div>
      {groups.map(g=><section id={g.id} class="spec-group"><h2>{g.title}</h2><table aria-label={g.title}><tbody>{g.rows.map(([key,value])=><tr><th scope="row">{key}</th><td>{value}</td></tr>)}</tbody></table></section>)}
      <p class="source-note">Данные P-41 приведены по сохранённой странице «Характеристики». Проектные параметры сверены с файлами «сайт весь материал.pdf» и «Сравнительная таблица (1).pdf». Грузоподъёмность и объём баков требуют уточнения: значения в материалах расходятся.</p>
      <a class="text-link" href="/equipment/">Рабочие системы и опции <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </div>
  <section class="system dark" id="transport"><div class="wrap system-grid"><Photo name="transport" alt="Перевозка гусеничного вездехода" sizes="(max-width: 760px) 90vw, 53vw" /><div><h2>Транспортировка</h2><p>Вездеход можно доставить эвакуатором или в кузове крытого грузового автомобиля. Для перевозки в морском контейнере гусеничные блоки снимают и размещают в кузове.</p></div></div></section>
</Site>
